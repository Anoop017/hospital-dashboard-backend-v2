# Application
APP_PORT=3000
APP_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=hospital_admin
POSTGRES_PASSWORD=hospital_pass_123
POSTGRES_DATABASE=hospital_db

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hospital_audit_db

# JWT
JWT_ACCESS_SECRET=super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Hashing
BCRYPT_SALT_ROUNDS=12

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Hospital Care System <your_email@gmail.com>"
PATIENT_PORTAL_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3001
