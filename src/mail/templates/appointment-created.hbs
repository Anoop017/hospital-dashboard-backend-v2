<h2 style="margin-top:0;font-size:18px;color:#0f172a;">Appointment Confirmed & Scheduled</h2>
<p>Dear <strong>{{patientName}}</strong>,</p>
<p>Your appointment has been successfully scheduled. Here are the details:</p>

<div class="info-card">
  <div class="info-row">
    <span class="info-label">Doctor: </span>
    <span class="info-value">Dr. {{doctorName}} {{#if doctorSpecialization}}({{doctorSpecialization}}){{/if}}</span>
  </div>
  <div class="info-row">
    <span class="info-label">Date & Time: </span>
    <span class="info-value">{{appointmentDate}}</span>
  </div>
  <div class="info-row">
    <span class="info-label">Status : </span>
    <span class="info-value"><span class="badge badge-{{statusClass}}">{{status}}</span></span>
  </div>
  {{#if reason}}
  <div class="info-row">
    <span class="info-label">Reason / Notes: </span>
    <span class="info-value">{{reason}}</span>
  </div>
  {{/if}}
</div>

<p style="font-size:14px;color:#64748b;">
  Please arrive 10 minutes prior to your scheduled time. If you need to reschedule or cancel, you can manage your appointment from the patient portal.
</p>

{{#if portalUrl}}
<div style="text-align: center; margin-top: 24px;">
  <a href="{{{portalUrl}}}" class="button" target="_blank">View My Appointments</a>
</div>
{{/if}}
